# URL del backend propio (Node.js), SIN diagonal al final.
# Deja vacío si en Vercel reenvías /api al backend con un rewrite (ver API_CONTRACT.md).
# Local:       http://localhost:3000
# Producción:  https://tu-backend.vercel.app
VITE_BACKEND_URL=http://localhost:3000

# true = usa datos de demostración sin backend (solo para desarrollo).
# En producción y en la demo del examen debe ser false.
VITE_USE_MOCK=false
